# expo-three@8's peer range (^0.166.0) assumes a WebGL2 context, but expo-gl only exposes WebGL1
# on-device — three.js dropped WebGL1 support in r163, so we deliberately pin `three` to 0.162.0
# (see frontend/package.json). That's an intentional, verified-working mismatch, not neglect —
# legacy-peer-deps keeps plain `npm install` from erroring on it.
legacy-peer-deps=true
